<Window x:Class="dir2tree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:dir2tree.UI"
        Title="Dir2Tree"
        Width="940" Height="680"
        MinWidth="660" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="12.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <!-- Custom, Fluent-style title bar: the 48px strip drags the window and
         double-click maximizes it; the caption buttons opt back into hit
         testing through WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Base surface -->
        <Border Background="{StaticResource WindowBackgroundBrush}" />

        <!-- Ambient accent light. An empty layer: never carries text. -->
        <Border Background="{StaticResource AmbientGlowBrush}"
                Width="640" Height="360"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="-80,-110,0,0"
                IsHitTestVisible="False" />

        <!-- Hairline window outline -->
        <Border BorderBrush="{StaticResource WindowStrokeBrush}" BorderThickness="1"
                IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" />

            <Grid Grid.Row="1" Margin="24,6,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================== Source folder ============================== -->
                <Grid Grid.Row="0">
                    <!-- Elevation on an empty, inset layer so the card text keeps ClearType -->
                    <Border Margin="10,12,10,0" CornerRadius="{StaticResource RadiusLarge}"
                            Background="{StaticResource ShadowLayerBrush}" Opacity="0.45"
                            Effect="{StaticResource CardShadowEffect}"
                            IsHitTestVisible="False" />

                    <Border Style="{StaticResource CardStyle}" Padding="20,17,20,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="15"
                                               Foreground="{StaticResource AccentLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Source folder"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Pick the directory you want to print as a tree"
                                               Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtPath" Grid.Column="0"
                                         Style="{StaticResource PathTextBoxStyle}"
                                         Tag="e.g. C:\Projects\MyApp"
                                         Margin="0,0,10,0" />

                                <Button x:Name="btnBrowse" Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnBrowse_Click"
                                        ToolTip="Browse for a folder">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8E5;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Browse&#x2026;" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================== Primary action ============================== -->
                <Grid Grid.Row="1" Margin="0,16,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Tip: Copy in the output header grabs the whole tree."
                               VerticalAlignment="Center" Margin="2,0,16,0"
                               FontSize="11.5"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="btnGenerate" Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="46" MinWidth="248"
                            Click="BtnGenerate_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE768;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Generate Tree" Margin="10,0,0,0"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ============================== Tree output ============================== -->
                <Grid Grid.Row="2">
                    <Border Margin="10,12,10,0" CornerRadius="{StaticResource RadiusLarge}"
                            Background="{StaticResource ShadowLayerBrush}" Opacity="0.45"
                            Effect="{StaticResource CardShadowEffect}"
                            IsHitTestVisible="False" />

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Card header: label, hairline, copy action -->
                            <Grid Grid.Row="0" Height="44" Margin="18,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="TREE OUTPUT"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1" Height="1" Margin="12,0"
                                        Background="{StaticResource SurfaceStrokeBrush}"
                                        VerticalAlignment="Center" Opacity="0.8" />

                                <Button x:Name="btnCopy" Grid.Column="2"
                                        Width="32" Height="28"
                                        Click="BtnCopy_Click"
                                        ToolTip="Copy to Clipboard"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Button.RenderTransform>
                                    <Button.Style>
                                        <!-- Icon button + a purely visual click pulse -->
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="0.4" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.88" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.34" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.88" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.34" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="13" />
                                </Button>
                            </Grid>

                            <!-- Output surface -->
                            <Border Grid.Row="1"
                                    CornerRadius="0,0,11,11"
                                    BorderBrush="{StaticResource SurfaceStrokeBrush}"
                                    BorderThickness="0,1,0,0"
                                    Background="{StaticResource CardHeaderBrush}">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Focusable="False">
                                        <TextBlock x:Name="txtOutput"
                                                   Margin="20,16,16,16"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap"
                                                   Foreground="{StaticResource OutputTextBrush}" />
                                    </ScrollViewer>

                                    <!-- Empty state: shown only while txtOutput is empty -->
                                    <TextBlock Text="No output yet. Pick a folder, then press Generate Tree."
                                               Margin="21,18,24,0" VerticalAlignment="Top"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtOutput}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
