<UserControl x:Class="dir2tree.UI.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48"
             Focusable="False"
             Background="Transparent">

    <!-- The whole strip lives inside the WindowChrome caption area, so it
         drags and double-click-maximizes the window for free. The three
         buttons opt back into normal hit testing. -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- App mark -->
        <Grid Grid.Column="0" Width="26" Height="26" Margin="16,0,11,0"
              VerticalAlignment="Center">
            <Border CornerRadius="8" Background="{StaticResource AccentBrush}"
                    Effect="{StaticResource ButtonGlowEffect}" Opacity="0.35" />
            <Border CornerRadius="8" Background="{StaticResource AccentGradientBrush}" />
            <Viewbox Width="14" Height="14">
                <Canvas Width="16" Height="16">
                    <Path Data="M4.2,2.2 L4.2,13.8 M4.2,5.2 L10.4,5.2 M4.2,11.4 L10.4,11.4"
                          Stroke="#FFFFFFFF" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="9.9" Canvas.Top="3.5" Width="3.3" Height="3.3"
                             Fill="#FFFFFFFF" />
                    <Ellipse Canvas.Left="9.9" Canvas.Top="9.7" Width="3.3" Height="3.3"
                             Fill="#FFFFFFFF" />
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Title / subtitle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Dir2Tree"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Folder structure generator"
                       Margin="0,1,0,0"
                       FontSize="10.5"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Caption buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,6,0">
            <Button x:Name="BtnMinimize"
                    Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE921;"
                    ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnMinimize_Click" />
            <Button x:Name="BtnMaximize"
                    Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE922;"
                    ToolTip="Maximize"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnMaximize_Click" />
            <Button x:Name="BtnClose"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnClose_Click" />
        </StackPanel>

        <!-- Hairline between the caption strip and the content -->
        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                Background="{StaticResource SurfaceStrokeBrush}" Opacity="0.7"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
