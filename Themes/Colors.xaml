<!--
    Themes/Colors.xaml
    ================================================================
    Single source of truth for the app palette, typography, corner
    radii and elevation effects.  Nothing in here touches app logic.

    Layer 1 : raw colors        (XxxColor)
    Layer 2 : brushes           (XxxBrush)   <- used by Controls.xaml
    Layer 3 : metrics / effects (RadiusXxx, XxxShadowEffect)
    ================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Layer 1 - Raw palette
         ============================================================ -->

    <!-- Window / app background -->
    <Color x:Key="BgTopColor">#FF1B1B26</Color>
    <Color x:Key="BgBottomColor">#FF111119</Color>
    <Color x:Key="WindowStrokeColor">#FF2A2A3A</Color>

    <!-- Surfaces (cards, header strips) -->
    <Color x:Key="SurfaceColor">#FF1E1E2B</Color>
    <Color x:Key="SurfaceAltColor">#FF232331</Color>
    <Color x:Key="SurfaceStrokeColor">#FF2D2D3E</Color>
    <Color x:Key="SurfaceStrokeStrongColor">#FF3A3A4E</Color>

    <!-- Controls (inputs, secondary buttons) -->
    <Color x:Key="ControlColor">#FF262635</Color>
    <Color x:Key="ControlHoverColor">#FF2E2E40</Color>
    <Color x:Key="ControlStrokeColor">#FF38384C</Color>
    <Color x:Key="ControlStrokeHoverColor">#FF4A4A64</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFF2F2F8</Color>
    <Color x:Key="TextSecondaryColor">#FFA7A7BE</Color>
    <Color x:Key="TextTertiaryColor">#FF6F6F88</Color>

    <!-- Accent (indigo / violet) -->
    <Color x:Key="AccentColor">#FF7C6CF6</Color>
    <Color x:Key="AccentLightColor">#FF9B8DFB</Color>
    <Color x:Key="AccentDarkColor">#FF6353E0</Color>
    <Color x:Key="AccentSoftColor">#FF2A2545</Color>

    <!-- Feedback / chrome -->
    <Color x:Key="DangerColor">#FFE5484D</Color>
    <Color x:Key="ScrollThumbColor">#FF3A3A4D</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF56566F</Color>

    <!-- ============================================================
         Layer 2 - Brushes
         ============================================================ -->

    <!-- Backgrounds -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="{StaticResource BgTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource BgBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowStrokeBrush" Color="{StaticResource WindowStrokeColor}" />

    <!-- Solid fill behind the window (keeps corners clean where DWM does not round them) -->
    <SolidColorBrush x:Key="WindowBaseBrush" Color="{StaticResource BgBottomColor}" />

    <!-- Soft accent light in the top-left corner of the window -->
    <RadialGradientBrush x:Key="AmbientGlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D7C6CF6" Offset="0" />
        <GradientStop Color="#107C6CF6" Offset="0.55" />
        <GradientStop Color="#007C6CF6" Offset="1" />
    </RadialGradientBrush>

    <!-- Surfaces -->
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="{StaticResource SurfaceAltColor}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{StaticResource SurfaceStrokeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeStrongBrush" Color="{StaticResource SurfaceStrokeStrongColor}" />
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ShadowLayerBrush" Color="#FF0B0B12" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="ControlStrokeHoverBrush" Color="{StaticResource ControlStrokeHoverColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />

    <!-- Tree output: slightly softer than body text, still high contrast on the card -->
    <SolidColorBrush x:Key="OutputTextBrush" Color="#FFD9D9E6" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.6" />
        <GradientStop Color="{StaticResource AccentDarkColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Hover / pressed overlays (laid on top of the base fill) -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#33000000" />
    <SolidColorBrush x:Key="SubtleHoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedOverlayBrush" Color="#24000000" />
    <SolidColorBrush x:Key="InnerHighlightBrush" Color="#3DFFFFFF" />

    <!-- Feedback -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />

    <!-- ============================================================
         Layer 3 - Typography
         ============================================================ -->

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================================================
         Layer 3 - Metrics
         ============================================================ -->

    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">9</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- ============================================================
         Layer 3 - Elevation
         The shadows are always applied to a dedicated, text-free
         layer (or a small icon), never to a container that holds
         text: a bitmap Effect would drop ClearType for its children.
         ============================================================ -->

    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="26" ShadowDepth="10"
                      Direction="270" Opacity="0.55" Color="#FF04040A"
                      RenderingBias="Quality" />

    <DropShadowEffect x:Key="ButtonGlowEffect" BlurRadius="16" ShadowDepth="4"
                      Direction="270" Opacity="0.65" Color="#FF7C6CF6"
                      RenderingBias="Quality" />

</ResourceDictionary>
